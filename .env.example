# Neon Postgres (use the pooled connection string in the app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin dashboard — login with this email + password
ADMIN_EMAIL=you@example.com
# At least 12 characters. Set this in Vercel, never commit the real value.
ADMIN_PASSWORD=
# Optional alternative: bcrypt hash instead of a plaintext password
# ADMIN_PASSWORD_HASH=

# Public site URL, no trailing slash (used for payment redirects)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Morning / Green Invoice
# production | sandbox
MORNING_ENV=sandbox
MORNING_CLIENT_ID=
MORNING_CLIENT_SECRET=
# Payment plugin UUID from Morning: documents/info?type=320 → paymentPlugins[0].id
MORNING_PLUGIN_ID=
# Shared secret appended as ?token= on the webhook URL
MORNING_WEBHOOK_TOKEN=

# Vercel cron (Authorization: Bearer). At least 16 random characters.
CRON_SECRET=
